<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The log file is written to getExternalFilesDir(null), with internal
         storage as a fallback, so expose both. The names must be unique:
         FileProvider keys its roots by name, so duplicate names would make
         the second root silently replace the first. -->
    <external-files-path name="external_logs" path="." />
    <files-path name="internal_logs" path="." />
    <!-- Sound themes are zipped into the cache before being handed to the
         share sheet; nothing else in the cache is exposed. -->
    <cache-path name="shared_themes" path="shared_themes/" />
</paths>
