<resources>

    <!--
        Base application theme. Every activity in the app is an AppCompat
        activity, so the AppCompat theme is used everywhere (the old
        per-API-level Holo variants in res/values-vXX are gone; AppCompat
        takes care of platform differences itself).
    -->
    <style name="AppBaseTheme" parent="Theme.AppCompat.Light.DarkActionBar">
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
    </style>

    <!-- Theme for the settings screen, which uses androidx.preference and
         therefore needs an AppCompat theme with the preference theme set. -->
    <style name="PrefsTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

</resources>
