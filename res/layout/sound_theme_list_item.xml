<?xml version="1.0" encoding="utf-8"?>
<!--
  A normal, interactive list row: clickable and long-clickable so TalkBack
  announces it as an actionable list item (double tap to use the theme,
  long press for more options) rather than as a plain label. Both flags
  matter - without longClickable the screen reader offers no way to reach
  the actions popup at all.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp" >

    <TextView
        android:id="@+id/tv_theme_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_theme_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#66000000"
        android:textSize="14sp" />
</LinearLayout>
